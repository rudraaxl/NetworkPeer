{
  "name": "networkpeer-platform",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@types/react": "19.1.17",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "scripts": {
    "build:contracts": "npm run build --workspace @networkpeer/contracts",
    "typecheck:contracts": "npm run typecheck --workspace @networkpeer/contracts",
    "typecheck:api": "npm run typecheck --workspace networkpeer-api",
    "typecheck:web": "npm run typecheck --workspace networkpeer-web",
    "typecheck:mobile": "npm run typecheck --workspace networkpeer-mobile",
    "test:api": "npm test --workspace networkpeer-api"
  }
}

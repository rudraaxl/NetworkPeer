# Application
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# Database (PostgreSQL with PostGIS). Production uses separate non-superuser
# principals for normal request handling, admin controls, media verification,
# and financial definer commands. All production URLs require sslmode=require.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/networkpeer
# Leave privileged URLs empty in local development to use DATABASE_URL. They
# are mandatory and must use distinct roles in production.
# DATABASE_ADMIN_URL=   # unset: falls back to DATABASE_URL
# DATABASE_MEDIA_VERIFIER_URL=   # unset: falls back to DATABASE_URL
# DATABASE_FINANCIAL_URL=   # unset: falls back to DATABASE_URL
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
# Keep false for AWS and every internet-reachable deployment.
# Docker Compose uses true only on its private postgres/redis bridge network.
ALLOW_INSECURE_INTERNAL_TRANSPORT=false

# Redis
REDIS_URL=redis://localhost:6379

# Cognito Custom Authentication
# Provision the user pool's Define/Create/Verify Auth Challenge triggers and
# CLIENT, WORKER, and ADMIN groups before enabling authentication.
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=us-east-1
COGNITO_CHALLENGE_TTL_SECONDS=300
COGNITO_REFRESH_TTL_SECONDS=604800

# Browser refresh sessions are HttpOnly cookies. Leave DOMAIN empty for a
# host-only cookie; use SameSite=none only for cross-site frontend/API origins.
WEB_SESSION_COOKIE_NAME=networkpeer_refresh
WEB_SESSION_COOKIE_DOMAIN=
WEB_SESSION_COOKIE_SAME_SITE=lax
WEB_SESSION_COOKIE_SECURE=false

# AWS S3 Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
# Leave all three credential variables blank when using an instance/task role.
AWS_SESSION_TOKEN=
AWS_S3_BUCKET=networkpeer-media
# Short-lived presigned POST policy. In production startup verifies all block-
# public-access controls, default server-side encryption, and versioning; the
# runtime IAM role therefore needs s3:GetPublicAccessBlock,
# s3:GetBucketEncryption, and s3:GetBucketVersioning. Configure a lifecycle
# rule for abandoned pending evidence uploads.
AWS_S3_PRESIGNED_URL_EXPIRY_SECONDS=600
MEDIA_MAX_FILE_SIZE_BYTES=26214400

# Payment Gateway (Stripe Connect)
# Use stub locally; production requires stripe plus real Stripe credentials.
PAYMENT_GATEWAY=stub
PAYMENT_WEBHOOK_SECRET=development-payment-webhook-secret
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
# Fee is retained from the funded job budget at approval. 1000 = 10.00%.
PLATFORM_FEE_BPS=1000
STRIPE_SECRET_KEY=sk_test_your-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_CONNECT_CLIENT_ID=ca_your-connect-client-id
# PostgreSQL-backed payment operation dispatcher. It can run in the API process
# or through `npm run worker` with the same provider configuration.
PAYMENT_DISPATCH_ENABLED=true
PAYMENT_DISPATCH_INTERVAL_MS=5000
PAYMENT_DISPATCH_BATCH_SIZE=20

# Push Notifications (Firebase)
FIREBASE_PROJECT_ID=your-firebase-project
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# Enable only after all Firebase service-account values are configured.
PUSH_NOTIFICATIONS_ENABLED=false
PUSH_DISPATCH_INTERVAL_MS=5000

# Phase 9 background queues. Redis is transport only; PostgreSQL media/sync
# outboxes make missed jobs recoverable on the next sweep.
BACKGROUND_QUEUES_ENABLED=true
BACKGROUND_QUEUE_POLL_INTERVAL_MS=5000
BACKGROUND_MEDIA_CONCURRENCY=2
BACKGROUND_PUSH_CONCURRENCY=4

# Browser API and Socket.IO origins. Production accepts explicit HTTPS origins only.
CORS_ORIGINS=http://localhost:8080,http://localhost:3001,http://localhost:5173
# Leave empty for a direct listener. Behind a reverse proxy, list only the
# proxy's IP/CIDR ranges so request.ip cannot be forged with forwarded headers.
TRUST_PROXY_CIDRS=
REALTIME_ENABLED=true
SYNC_MAX_PAGE_SIZE=100

# Sentry
# Leave empty to disable Sentry locally. Production should use a real DSN.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Fastify Redis-backed global rate limiting. OTP endpoints retain stricter
# phone-specific limits above.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
MAX_REQUEST_BODY_BYTES=1048576

# Worker discovery
WORKER_NEARBY_MAX_RADIUS_KM=100

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# --- Email delivery (NP-02) ---------------------------------------------
# "log" prints the OTP to the API console and is development-only: in
# production it now fails closed rather than reporting a delivery that never
# happened. Use "ses" once an identity is verified, or "resend".
EMAIL_PROVIDER=log
EMAIL_FROM=
SES_REGION=
SES_CONFIGURATION_SET=

# --- Token signing (NP-04) ----------------------------------------------
# Leave blank in development and a random per-process secret is generated, so
# tokens never outlive a restart. Production refuses to boot without a real
# value of at least 32 characters.
JWT_SECRET=

# --- Admin bootstrap (NP-12) --------------------------------------------
# There is no API that can create an administrator. Sign in once through the
# normal flow, then: npm run grant-admin -- you@example.com

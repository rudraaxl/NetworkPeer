{
  "name": "networkpeer-api",
  "version": "1.0.0",
  "description": "NetworkPeer - Field Work Marketplace Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/background-worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src scripts tests --ext .ts",
    "typecheck": "tsc --project tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "RUN_E2E=true PAYMENT_DISPATCH_ENABLED=false BACKGROUND_QUEUES_ENABLED=false vitest run tests/e2e",
    "migrate": "tsx scripts/migrate.ts",
    "verify:phase1": "tsx scripts/verify-phase1.ts",
    "verify:auth": "tsx scripts/verify-auth-security.ts",
    "verify:phase4": "tsx scripts/verify-phase4.ts",
    "verify:phase5": "tsx scripts/verify-phase5.ts",
    "verify:phase6": "tsx scripts/verify-phase6.ts",
    "verify:phase7": "tsx scripts/verify-phase7.ts",
    "verify:phase8": "tsx scripts/verify-phase8.ts",
    "verify:phase9": "tsx scripts/verify-phase9.ts",
    "db:status": "docker ps --filter name=networkpeer-postgis --format 'DB container: {{.Names}} on {{.Ports}}'",
    "db:shell": "docker exec -it networkpeer-postgis psql -U postgres -d networkpeer",
    "db:tables": "docker exec networkpeer-postgis psql -U postgres -d networkpeer -c '\\dt'",
    "db:query": "docker exec networkpeer-postgis psql -U postgres -d networkpeer -c \"$npm_config_sql\"",
    "db:reset": "docker exec networkpeer-postgis psql -U postgres -d networkpeer -c 'DROP SCHEMA public CASCADE; CREATE SCHEMA public;' && npm run migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-presigned-post": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "@networkpeer/contracts": "*",
    "@sentry/node": "^10.70.0",
    "bullmq": "^6.0.10",
    "dotenv": "^16.3.1",
    "fastify": "^5.11.2",
    "ioredis": "^5.3.2",
    "pg": "^8.11.3",
    "pino": "^8.16.2",
    "pino-pretty": "^10.2.3",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3",
    "supertest": "^7.2.2",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.54.0",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.6.0",
    "typescript": "^5.3.2",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
